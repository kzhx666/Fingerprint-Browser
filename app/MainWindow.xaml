<Window x:Class="KZManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KZ 指纹浏览器控制台 (商业专业版)"
        Height="780" Width="1240" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource B_Bg}"
        FontFamily="{StaticResource F_Ui}"
        Foreground="{DynamicResource B_Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= 左侧商业级导航侧边栏 ================= -->
        <Border Grid.Column="0" Background="{DynamicResource B_Header}" BorderBrush="{DynamicResource B_Line}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 品牌 Logo -->
                <StackPanel Grid.Row="0" Margin="18,18,18,20" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4C8DFF" Offset="0"/>
                                <GradientStop Color="#7C5CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="KZ" Foreground="White" FontSize="16"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="KZ Studio" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="商业多开控制中心" FontSize="11" Foreground="{DynamicResource B_TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 导航菜单项 -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button x:Name="NavProfiles" Content="📱  环境管理 (Profiles)" Style="{StaticResource BtnPrimary}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavProfiles_Click"/>
                    <Button x:Name="NavProxies" Content="🌐  代理中心 (Proxies)" Style="{StaticResource BtnGhost}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavProxies_Click"/>
                    <Button x:Name="NavSync" Content="🔄  窗口同步器 (Sync)" Style="{StaticResource BtnGhost}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavSync_Click"/>
                    <Button x:Name="NavHealth" Content="🛡️  指纹与健康 (Health)" Style="{StaticResource BtnGhost}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavHealth_Click"/>
                    <Button x:Name="NavExtensions" Content="🧩  扩展插件 (Extensions)" Style="{StaticResource BtnGhost}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavExtensions_Click"/>
                    <Button x:Name="NavAutomation" Content="🤖  自动化生态 (API/RPA)" Style="{StaticResource BtnGhost}"
                            HorizontalContentAlignment="Left" Padding="14,10" Margin="0,2" Click="NavAutomation_Click"/>
                </StackPanel>

                <!-- 底部工作区与版本 -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource B_Line}" BorderThickness="0,1,0,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="当前数据工作区:" FontSize="10" Foreground="{DynamicResource B_Dim2}"/>
                        <TextBlock x:Name="RootLabel" Text="D:\KZProfiles" FontSize="11"
                                   Foreground="{DynamicResource B_TextDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnTheme" Content="☀" Style="{StaticResource BtnGhost}"
                                    FontSize="14" Width="32" Height="32" Margin="0,0,6,0"
                                    ToolTip="切换深色/浅色" Click="BtnTheme_Click"/>
                            <Button x:Name="BtnRefresh" Content="🔄 刷新" Style="{StaticResource BtnGhost}"
                                    Height="32" Click="BtnRefresh_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 右侧主视图区 ================= -->
        <Grid Grid.Column="1">
            <!-- ==================== TAB 0: 环境管理 ==================== -->
            <Grid x:Name="ViewProfiles" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏快速操作与搜索 -->
                <Border Grid.Row="0" Background="{DynamicResource B_Header}" BorderBrush="{DynamicResource B_Line}"
                        BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 常用动作按钮 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnNew" Content="＋ 新建环境" Style="{StaticResource BtnPrimary}"
                                    Margin="0,0,8,0" Click="BtnNew_Click"/>
                            <Button x:Name="BtnSmartGen" Content="✨ 智能生成" Style="{StaticResource Btn}"
                                    Margin="0,0,8,0" ToolTip="一键生成完整相容设备指纹" Click="BtnSmartGen_Click"/>
                            <Button x:Name="BtnBatchStart" Content="▶ 批量启动" Style="{StaticResource Btn}"
                                    Margin="0,0,6,0" Click="BtnBatchStart_Click"/>
                            <Button x:Name="BtnBatchStop" Content="■ 批量停止" Style="{StaticResource BtnDanger}"
                                    Margin="0,0,6,0" Click="BtnBatchStop_Click"/>
                            <Button x:Name="BtnTile" Content="⊞ 窗口平铺" Style="{StaticResource Btn}"
                                    Margin="0,0,6,0" ToolTip="网格平铺当前打开的所有窗口" Click="BtnTile_Click"/>
                            <Button x:Name="BtnPackPortable" Content="📦 一键便携打包" Style="{StaticResource Btn}"
                                    Margin="0,0,6,0" ToolTip="将选中的实例环境与定制内核一键打包为便携绿色ZIP，可转移到其他电脑直接使用" Click="BtnPackPortable_Click"/>
                        </StackPanel>

                        <!-- 搜索框 -->
                        <Grid Grid.Column="1" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="32,6,10,6"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchHint" Text="搜索 名称 / 标签 / 平台 / 时区 / 出口"
                                       Foreground="{DynamicResource B_Dim2}" FontSize="11" Margin="32,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Path Data="M 10 10 L 14 14 M 12 6 A 6 6 0 1 0 12 18 A 6 6 0 1 0 12 6"
                                  Stroke="{DynamicResource B_Dim2}" StrokeThickness="1.5"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Margin="10,0,0,0" Width="16" Height="16" Stretch="None"/>
                        </Grid>

                        <!-- 快捷标签筛选 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnFilterAll" Content="全部" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="FilterChip_Click"/>
                            <Button x:Name="BtnFilterRunning" Content="🟢 运行中" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="FilterChip_Click"/>
                            <Button x:Name="BtnFilterUS" Content="🇺🇸 美区" Style="{StaticResource BtnGhost}" Margin="0,0,4,0" Click="FilterChip_Click"/>
                            <Button x:Name="BtnFilterJP" Content="🇯🇵 日区" Style="{StaticResource BtnGhost}" Click="FilterChip_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 环境表格 -->
                <Border Grid.Row="1" Margin="18,14,18,10" CornerRadius="10"
                        Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1">
                    <Grid>
                        <DataGrid x:Name="Grid" Style="{StaticResource Grid}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}"
                                  CellStyle="{StaticResource GridCell}"
                                  RowStyle="{StaticResource GridRow}"
                                  MouseDoubleClick="Grid_MouseDoubleClick"
                                  SelectionChanged="Grid_SelectionChanged"
                                  Sorting="Grid_Sorting">
                            <DataGrid.Columns>
                                <!-- 多选复选框列 -->
                                <DataGridTemplateColumn Width="36" CanUserSort="False" CanUserResize="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="ChkSelectAll" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="全选 / 取消全选" Click="ChkSelectAll_Click"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="32" CanUserSort="False" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border x:Name="grip" Background="Transparent" Cursor="Hand"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <UniformGrid Rows="3" Columns="2" Width="8" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                    <Ellipse Width="2" Height="2" Margin="1" Fill="{DynamicResource B_Dim2}"/>
                                                </UniformGrid>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="名称 / 平台" Width="2.2*" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Visibility="{Binding MasterBadge}" Background="{DynamicResource B_Accent}"
                                                        CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                    <TextBlock Text="主控" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="0.9*"/>
                                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="1.1*"/>
                                <DataGridTextColumn Header="时区" Binding="{Binding Timezone}" Width="1.4*"/>
                                <DataGridTextColumn Header="代理配置" Binding="{Binding ProxyDisplay}" Width="2*"/>
                                <DataGridTextColumn Header="出口状态" Binding="{Binding ExitStatus}" Width="1.2*"/>
                                <DataGridTextColumn Header="Seed" Binding="{Binding Seed}" Width="0.8*"/>

                                <DataGridTemplateColumn Header="运行状态" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource B_Scroll}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource B_Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource B_TextDim}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Running}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource B_Green}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 插入指示线 -->
                        <Border x:Name="DropLine" Height="2" Background="{DynamicResource B_Accent}"
                                VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed"/>

                        <!-- 空状态 -->
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="暂无环境" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource B_TextDim}" HorizontalAlignment="Center"/>
                            <TextBlock Text="点击上方「新建环境」或「智能生成」立即创建" FontSize="12" Foreground="{DynamicResource B_Dim2}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 底部操作底栏 -->
                <Border Grid.Row="2" Background="{DynamicResource B_Header}" BorderBrush="{DynamicResource B_Line}"
                        BorderThickness="0,1,0,0" Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 选中环境操作 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStart" Content="▶ 启动" Style="{StaticResource BtnPrimary}" MinWidth="85" Margin="0,0,8,0" Click="BtnStart_Click"/>
                            <Button x:Name="BtnStop" Content="■ 停止" Style="{StaticResource BtnDanger}" MinWidth="85" Margin="0,0,8,0" Click="BtnStop_Click"/>
                            <Button x:Name="BtnEdit" Content="⚙ 编辑" Style="{StaticResource Btn}" MinWidth="75" Margin="0,0,8,0" Click="BtnEdit_Click"/>
                            <Button x:Name="BtnClone" Content="📋 克隆" Style="{StaticResource Btn}" MinWidth="75" Margin="0,0,8,0" Click="BtnClone_Click"/>
                            <Button x:Name="BtnMore" Content="更多 ▾" Style="{StaticResource Btn}" MinWidth="85" Click="BtnMore_Click">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="上移一位" Click="MenuMoveUp_Click"/>
                                        <MenuItem Header="下移一位" Click="MenuMoveDown_Click"/>
                                        <MenuItem Header="恢复默认顺序" Click="MenuResetOrder_Click"/>
                                        <Separator/>
                                        <MenuItem Header="创建快捷方式…" Click="MenuShortcut_Click"/>
                                        <MenuItem Header="打开数据目录" Click="MenuOpenDir_Click"/>
                                        <Separator/>
                                        <MenuItem Header="指纹冲突诊断" Click="MenuConsistency_Click"/>
                                        <MenuItem Header="地域自动联动" Click="MenuAutoAlign_Click"/>
                                        <MenuItem Header="内核完整性自检" Click="MenuKernelCheck_Click"/>
                                        <MenuItem Header="健康巡检与评分" Click="MenuHealthScore_Click"/>
                                        <Separator/>
                                        <MenuItem Header="一键备份…" Click="MenuBackupOne_Click"/>
                                        <MenuItem Header="一键还原…" Click="MenuRestoreOne_Click"/>
                                        <MenuItem Header="创建快照" Click="MenuSnapshot_Click"/>
                                        <MenuItem Header="从快照还原" Click="MenuRestore_Click"/>
                                        <MenuItem Header="同步数据（书签/密码/历史/扩展）" Click="MenuSync_Click"/>
                                        <Separator/>
                                        <MenuItem Header="启动前出口 IP 预检" x:Name="MenuProxyPrecheck" IsCheckable="True" Click="MenuProxyPrecheck_Click"/>
                                        <MenuItem Header="出口地区比对（不符时警告）" x:Name="MenuRegionCheck" IsCheckable="True" Click="MenuRegionCheck_Click"/>
                                        <MenuItem Header="地区不符时拦截启动" x:Name="MenuRegionBlock" IsCheckable="True" Click="MenuRegionBlock_Click"/>
                                        <MenuItem Header="智能默认浏览器：跟随前台实例" x:Name="MenuSmartDefault" IsCheckable="True" IsChecked="True" Click="MenuSmartDefault_Click"/>
                                        <Separator/>
                                        <MenuItem Header="删除实例…" Click="MenuDelete_Click" Foreground="{DynamicResource B_Red}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <!-- 状态与数量统计提示 -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="CountText" Text="正在加载环境…" FontSize="12" Foreground="{DynamicResource B_TextDim}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{DynamicResource B_Dim2}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== TAB 1: 代理管理中心 ==================== -->
            <Grid x:Name="ViewProxies" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,14" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🌐 代理池管理中心" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="批量导入 host:port:user:pass 或 socks5:// 格式代理，一键测速并按分组均衡分配给各环境"
                                       FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnImportProxies" Content="＋ 批量导入" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Click="BtnImportProxies_Click"/>
                            <Button x:Name="BtnTestProxies" Content="⚡ 批量测速" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnTestProxies_Click"/>
                            <Button x:Name="BtnAssignProxies" Content="🎯 自动分配" Style="{StaticResource Btn}" Click="BtnAssignProxies_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8">
                    <DataGrid x:Name="GridProxies" Style="{StaticResource Grid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              RowStyle="{StaticResource GridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="主机地址" Binding="{Binding Host}" Width="1.5*"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="0.7*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="0.8*"/>
                            <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="1*"/>
                            <DataGridTextColumn Header="延迟 (ms)" Binding="{Binding LatencyMs}" Width="0.9*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Alive}" Width="0.8*"/>
                            <DataGridTextColumn Header="分配数" Binding="{Binding AssignedCount}" Width="0.8*"/>
                            <DataGridTextColumn Header="检测时间" Binding="{Binding LastChecked}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ==================== TAB 2: 多窗口同步器 ==================== -->
            <Grid x:Name="ViewSync" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,14" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="🔄 多窗口操作同步器 (Action Synchronizer)" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="选择主控窗口，鼠标点击、滚动、键盘输入及网址导航实时广播到指定的从属环境"
                                       FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,12"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="主控窗口: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbSyncMaster" Width="180" Margin="0,0,16,0"/>
                            <Button x:Name="BtnSyncStart" Content="▶ 开启同步" Style="{StaticResource BtnPrimary}" MinWidth="90" Margin="0,0,8,0" Click="BtnSyncStart_Click"/>
                            <Button x:Name="BtnSyncPause" Content="⏸ 暂停/恢复" Style="{StaticResource Btn}" MinWidth="90" Margin="0,0,8,0" Click="BtnSyncPause_Click"/>
                            <Button x:Name="BtnSyncStop" Content="⏹ 停止同步" Style="{StaticResource BtnDanger}" MinWidth="90" Margin="0,0,16,0" Click="BtnSyncStop_Click"/>
                            <Button Content="⊞ 一键平铺所有窗口" Style="{StaticResource BtnGhost}" Click="BtnTile_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="同步从属窗口列表（勾选参与同步的目标）" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <ListBox x:Name="ListSyncSlaves" Grid.Row="1" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== TAB 3: 指纹与健康 ==================== -->
            <Grid x:Name="ViewHealth" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,14" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🛡️ 指纹冲突诊断与地域联动" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="检查实例 UA、语言、时区、显卡特征与出口地区的相容性，提供一键自动补齐与跑分"
                                       FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnAutoAlignTab" Content="⚡ 地域自动联动" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" Click="MenuAutoAlign_Click"/>
                            <Button x:Name="BtnDiagCheck" Content="🔍 冲突诊断" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="MenuConsistency_Click"/>
                            <Button x:Name="BtnBenchTab" Content="🧪 真实浏览器跑分" Style="{StaticResource Btn}" Click="BtnRunBench_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="TxtHealthReport" Text="请在上方选择操作，或双击左侧列表中的环境进行深度诊断。"
                                   FontFamily="{StaticResource F_Mono}" FontSize="12" Foreground="{DynamicResource B_Text}"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ==================== TAB 4: 扩展插件 ==================== -->
            <Grid x:Name="ViewExtensions" Visibility="Collapsed" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,14" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🧩 本地扩展插件管理库" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="管理 _extensions 目录下的解压扩展包，可在编辑环境时一键勾选预装"
                                       FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📂 打开扩展目录" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="BtnOpenExtDir_Click"/>
                            <Button Content="🔄 刷新" Style="{StaticResource BtnGhost}" Click="BtnRefreshExt_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8">
                    <DataGrid x:Name="GridExtensions" Style="{StaticResource Grid}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              CellStyle="{StaticResource GridCell}"
                              RowStyle="{StaticResource GridRow}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="扩展 ID / 目录" Binding="{Binding Id}" Width="1.5*"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="0.8*"/>
                            <DataGridTextColumn Header="描述说明" Binding="{Binding Description}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ==================== TAB 5: 自动化与 API ==================== -->
            <Grid x:Name="ViewAutomation" Visibility="Collapsed" Margin="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Margin="0,0,0,14" Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="🤖 本地 REST API &amp; 自动化连接中心" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="供 Playwright、Puppeteer、Selenium 或后台自动化脚本通过 127.0.0.1:8790 调度控制环境"
                                           FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,4,0,14"/>

                                <TextBlock Text="当前 API 鉴权令牌 (存储于 _api-token, Windows ACL 单用户保护):" FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBox x:Name="TxtApiToken" Width="400" IsReadOnly="True" Style="{StaticResource Input}"/>
                                    <Button Content="📋 复制令牌" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="BtnCopyToken_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource B_Card}" BorderBrush="{DynamicResource B_Line}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="自动化框架直连示例代码 (支持 Playwright / Puppeteer / Selenium)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="调用 /connect?name=实例名 获取对应代码，或直接复制下方模板：" FontSize="12" Foreground="{DynamicResource B_TextDim}" Margin="0,0,0,10"/>
                                <TextBox x:Name="TxtSnippet" FontFamily="{StaticResource F_Mono}" FontSize="12"
                                         Height="260" IsReadOnly="True" TextWrapping="Wrap" Style="{StaticResource Input}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
